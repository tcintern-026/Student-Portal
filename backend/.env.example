# Copy this file to .env and fill in your real values.

# Port the Express API listens on.
PORT=4000

# Origin(s) allowed to call this API via CORS. Comma-separated for more than one.
CLIENT_ORIGIN=http://localhost:3000

# Postgres connection string from Neon: dashboard -> your project ->
# Connection Details -> "Connection string" (pooled connection recommended).
# Looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
